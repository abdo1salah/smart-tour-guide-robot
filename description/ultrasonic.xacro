<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
<xacro:macro name="ultrasonic_sensor" params="name x y z roll pitch yaw">
        
        <link name="${name}_link">
            <visual>
                <geometry>
                    <box size="0.02 0.04 0.02"/>
                </geometry>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.04 0.02"/>
                </geometry>
            </collision>
            <xacro:inertial_box mass="0.01" x="0.02" y="0.04" z="0.02">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="chassis"/>
            <child link="${name}_link"/>
            <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
        </joint>

        <gazebo reference="${name}_link">
            <material>Gazebo/Black</material>
            <sensor name="${name}" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <topic>${name}/scan</topic>
                <update_rate>10</update_rate>
                <visualize>true</visualize>
                <gz_frame_id>${name}_link</gz_frame_id>
                <frame_id>${name}_link</frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>5</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.26</min_angle>
                            <max_angle>0.26</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.02</min>      <max>4.0</max>       <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

</robot>